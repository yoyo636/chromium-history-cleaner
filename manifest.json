{
  "manifest_version": 3,
  "name": "浏览器搭子 · 历史与标签页管家",
  "version": "4.13.0",
  "description": "实用的跨浏览器搭子：历史清理、标签管理、书签去重、下载管理、浏览数据清理、会话存档、数据统计、视觉疲劳自适应护眼、标签页性能透视、音频静音管理与无痕追踪防护。兼容 Chromium 内核与 Firefox，液态玻璃界面。",
  "permissions": [
    "history",
    "storage",
    "downloads",
    "tabs",
    "bookmarks",
    "browsingData",
    "sessions",
    "tabCapture",
    "notifications",
    "cookies",
    "alarms",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "fatigue-engine.js",
        "content.js",
        "content_perf.js",
        "content_adblock.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content_privacy.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "adblock-static",
        "enabled": true,
        "path": "rules/adblock-rules.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "浏览器搭子",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
